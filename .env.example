# Copy to .env (git-ignored) and fill in. Never commit real credentials.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_NAME=Routematic
# Maintenance database used ONLY to check for / create the Routematic database.
DB_ADMIN_DB=postgres
# At least 32 random characters; the API refuses to start with this placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Access-token lifetime in minutes (default 30). The app renews it silently with a refresh token, so users
# are not signed out. JWT_EXPIRE_MINUTES (older name) is still read when ACCESS_TOKEN_MINUTES is not set —
# remove it from existing .env files, or it keeps the old long lifetime.
ACCESS_TOKEN_MINUTES=30
# Refresh-token lifetime in days (single-use, rotated on every renewal; replay ends all sessions).
REFRESH_TOKEN_DAYS=7
# Security events are written as JSON lines to the "routematic.security" logger; route that logger to your
# log store. Lock-outs, refresh-token replay, privilege changes, cross-tenant attempts and password changes
# are also stored in public.security_events (platform admins: GET /api/v1/security/events).
# Comma separated browser origins allowed by CORS (Flutter web dev server etc.)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080
# Development only: any http://localhost:<port> may call the API (default false). Production lists the
# real web origin(s) in CORS_ORIGINS and leaves this false.
CORS_ALLOW_LOCALHOST=false
# Sign-in brute-force protection: failed attempts per client + email within the window (seconds).
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SECONDS=900
# Time zone of the companies' business day, used for server-side "today" aggregates.
BUSINESS_TIMEZONE=Asia/Kolkata
# Also limited: failed sign-ins per client across all emails, and per email across all clients.
LOGIN_IP_MAX_FAILURES=100
LOGIN_ACCOUNT_MAX_FAILURES=30
# PostgreSQL TLS. Empty = "require" for a remote DB_HOST, "prefer" for localhost.
# For full certificate checking use verify-full and point DB_SSLROOTCERT at the server's CA file.
DB_SSLMODE=
DB_SSLROOTCERT=
# Swagger UI / ReDoc / openapi.json (keep false in production)
ENABLE_DOCS=false
# Send Strict-Transport-Security; enable only when the API is reached over HTTPS
HSTS_ENABLED=false
# Largest accepted request body in bytes (larger requests get 413)
MAX_BODY_BYTES=20971520
# Comma separated Host header allow-list, e.g. api.example.com (empty = not checked)
ALLOWED_HOSTS=
# JWT issuer / audience (changing them signs every user out)
JWT_ISSUER=routematic-api
JWT_AUDIENCE=routematic-app
# PBKDF2 work factor for new passwords (older hashes are upgraded at the next sign-in)
PASSWORD_HASH_ITERATIONS=600000
# Least-privilege layout (scripts/db_least_privilege.sql): schema-owner role used for provisioning/migrations.
DB_OWNER_ROLE=
